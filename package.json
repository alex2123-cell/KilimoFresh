{
  "name": "kilimo-fresh",
  "version": "1.0.0",
  "description": "KilimoFresh - Machakos produce sourcing hub connecting peri-urban farmers with institutional buyers (ACS 355)",
  "private": true,
  "main": "backend/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
